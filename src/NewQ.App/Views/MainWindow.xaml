<Window x:Class="NewQ.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:m="clr-namespace:NewQ.Core.Model;assembly=NewQ.Core"
        xmlns:c="clr-namespace:NewQ.App.Infrastructure"
        xmlns:ctl="clr-namespace:NewQ.App.Controls"
        xmlns:views="clr-namespace:NewQ.App.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="/Assets/NewQ.ico"
        Title="{Binding WindowTitle}"
        Width="1440" Height="880" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="Manual"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">

    <Window.Resources>
        <c:EnumDisplayConverter x:Key="EnumDisplay" />
        <c:FormatConverter x:Key="Format" />
        <c:RouteNameConverter x:Key="RouteName" />
        <c:CheckMarkConverter x:Key="CheckMark" />
        <c:EnumMatchToVisibilityConverter x:Key="EnumMatch" />
        <c:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <c:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
        </DataTemplate>

        <!-- Toolbar button: icon + label, no chrome until hovered. -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="ToolIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <!-- File picker shared by media cues -->
        <DataTemplate x:Key="FilePicker">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Sfoglia…" ctl:ButtonIcon.Glyph="{StaticResource IconFolder}"
                        VerticalAlignment="Bottom" Margin="0,0,8,12"
                        Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
                <TextBox ui:ControlHelper.Header="File" Text="{Binding FilePath, UpdateSourceTrigger=LostFocus}" Width="440" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="VideoRoutePicker">
            <ComboBox ui:ControlHelper.Header="Route video"
                      ItemsSource="{Binding DataContext.Workspace.VideoRoutes, RelativeSource={RelativeSource AncestorType=Window}}"
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding VideoRouteId}" Loaded="OnRoutePickerLoaded" />
        </DataTemplate>

        <DataTemplate x:Key="AudioRoutePicker">
            <ComboBox ui:ControlHelper.Header="Route audio"
                      ItemsSource="{Binding DataContext.Workspace.AudioRoutes, RelativeSource={RelativeSource AncestorType=Window}}"
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding AudioRouteId}" Loaded="OnRoutePickerLoaded" />
        </DataTemplate>

        <!-- ======================= Inspector pages (one tab each; MainWindow.InspectorPages lists them per cue type) =======================
             Fields flow left to right in rows (the panel is wide and short); the inspector's styles give them their width. -->

        <DataTemplate x:Key="PageBase">
            <WrapPanel>
                <TextBox ui:ControlHelper.Header="Numero" Text="{Binding Number}" Width="88" />
                <TextBox ui:ControlHelper.Header="Nome" Text="{Binding Name}" Width="320" />
                <TextBox ui:ControlHelper.Header="Note" Text="{Binding Notes}" Width="424"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="96" VerticalScrollBarVisibility="Auto" />
                <CheckBox Content="Armata" IsChecked="{Binding Armed}" />
            </WrapPanel>
        </DataTemplate>

        <!-- SHOW START / SHOW END markers: fixed rows, only notes (and, for START, how GO goes on) can change. -->
        <DataTemplate x:Key="PageMarker">
            <WrapPanel>
                <TextBox ui:ControlHelper.Header="Note" Text="{Binding Notes}" Width="424"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="96" VerticalScrollBarVisibility="Auto" />
                <CheckBox Content="GO dedicato" IsChecked="{Binding HasOwnGo}"
                          Visibility="{Binding IsStart, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageTrigger">
            <WrapPanel>
                <TextBox ui:ControlHelper.Header="Pre-wait (s)" Text="{Binding PreWait}" />
                <TextBox ui:ControlHelper.Header="Post-wait (s)" Text="{Binding PostWait}" />
                <ComboBox ui:ControlHelper.Header="Follow" ItemsSource="{x:Static c:EnumSources.ContinueModes}"
                          SelectedItem="{Binding ContinueMode}" ItemTemplate="{StaticResource EnumItem}" />
                <ComboBox ui:ControlHelper.Header="Link" ItemsSource="{x:Static c:EnumSources.LinkActions}"
                          SelectedItem="{Binding LinkAction}" ItemTemplate="{StaticResource EnumItem}" />
                <TextBox ui:ControlHelper.Header="Cue (numero)" Text="{Binding LinkTarget}"
                         Visibility="{Binding LinkAction, Converter={StaticResource EnumMatch}, ConverterParameter='Start,Stop,FadeOut'}" />
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageAudio">
            <WrapPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FilePicker}" Focusable="False" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AudioRoutePicker}" Focusable="False" />
                <TextBox ui:ControlHelper.Header="Volume (dB)" Text="{Binding VolumeDb}" />
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageAudioTime">
            <StackPanel>
                <WrapPanel>
                    <TextBox ui:ControlHelper.Header="Inizio (s)" Text="{Binding StartTime}" />
                    <TextBox ui:ControlHelper.Header="Fine (s, 0 = fine file)" Text="{Binding EndTime}" />
                    <TextBox ui:ControlHelper.Header="Fade in (s)" Text="{Binding FadeIn}" />
                    <TextBox ui:ControlHelper.Header="Fade out finale (s)" Text="{Binding FadeOut}" />
                    <CheckBox Content="Loop" IsChecked="{Binding Loop}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}">
                    <Run Text="Durata cue:" /> <Run Text="{Binding DurationText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageVideo">
            <WrapPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FilePicker}" Focusable="False" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoRoutePicker}" Focusable="False" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AudioRoutePicker}" Focusable="False" />
                <TextBox ui:ControlHelper.Header="Volume (dB)" Text="{Binding VolumeDb}" />
            </WrapPanel>
        </DataTemplate>

        <!-- Layer, fit and opacity of a visual cue (video, image, capture). -->
        <DataTemplate x:Key="PageDisplay">
            <WrapPanel>
                <TextBox ui:ControlHelper.Header="Layer" Text="{Binding Layer}" />
                <ComboBox ui:ControlHelper.Header="Adattamento" ItemsSource="{x:Static c:EnumSources.FitModes}"
                          SelectedItem="{Binding FitMode}" ItemTemplate="{StaticResource EnumItem}" />
                <TextBox ui:ControlHelper.Header="Opacità (0–1)" Text="{Binding Opacity}" />
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageVideoTime">
            <WrapPanel>
                <TextBox ui:ControlHelper.Header="Fade in (s)" Text="{Binding FadeIn}" />
                <TextBox ui:ControlHelper.Header="Fade out finale (s)" Text="{Binding FadeOut}" />
                <CheckBox Content="Loop" IsChecked="{Binding Loop}" />
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageImage">
            <WrapPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FilePicker}" Focusable="False" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoRoutePicker}" Focusable="False" />
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageImageTime">
            <WrapPanel>
                <TextBox ui:ControlHelper.Header="Durata (s, 0 = finché fermata)" Text="{Binding HoldDuration}" />
                <TextBox ui:ControlHelper.Header="Fade in (s)" Text="{Binding FadeIn}" />
                <TextBox ui:ControlHelper.Header="Fade out finale (s)" Text="{Binding FadeOut}" />
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageLiveSource">
            <WrapPanel>
                <StackPanel Orientation="Horizontal">
                    <ComboBox ui:ControlHelper.Header="Sorgente" IsEditable="True"
                              ItemsSource="{Binding DataContext.VideoCaptureDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                              Text="{Binding DeviceName, UpdateSourceTrigger=LostFocus}" />
                    <Button Style="{StaticResource SquareButton}" ctl:ButtonIcon.Glyph="&#xE72C;"
                            VerticalAlignment="Bottom" Margin="0,0,8,12" ToolTip="Aggiorna sorgenti"
                            Command="{Binding DataContext.RefreshDevicesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <ComboBox ui:ControlHelper.Header="Audio (vuoto = nessuno)" IsEditable="True"
                          ItemsSource="{Binding DataContext.AudioCaptureDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                          Text="{Binding AudioDeviceName, UpdateSourceTrigger=LostFocus}" />
                <TextBox ui:ControlHelper.Header="Risoluzione" Text="{Binding Resolution}"
                         ui:ControlHelper.PlaceholderText="predefinita, es. 1920x1080" />
                <TextBox ui:ControlHelper.Header="Frame rate (0 = auto)" Text="{Binding FrameRate}" />
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageLiveOutput">
            <WrapPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoRoutePicker}" Focusable="False" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AudioRoutePicker}" Focusable="False" />
                <TextBox ui:ControlHelper.Header="Volume (dB)" Text="{Binding VolumeDb}" />
                <TextBox ui:ControlHelper.Header="Fade in (s)" Text="{Binding FadeIn}" />
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageMidi">
            <StackPanel>
                <WrapPanel>
                    <ComboBox ui:ControlHelper.Header="Dispositivo (vuoto = predefinito)" IsEditable="True"
                              ItemsSource="{Binding DataContext.MidiDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                              Text="{Binding DeviceName, UpdateSourceTrigger=LostFocus}" />
                    <ComboBox ui:ControlHelper.Header="Messaggio" ItemsSource="{x:Static c:EnumSources.MidiKinds}"
                              SelectedItem="{Binding Kind}" ItemTemplate="{StaticResource EnumItem}" />
                    <TextBox ui:ControlHelper.Header="Canale (1–16)" Text="{Binding Channel}"
                             Visibility="{Binding Kind, Converter={StaticResource EnumMatch}, ConverterParameter='NoteOn,NoteOff,ControlChange,ProgramChange,PitchBend'}" />
                    <TextBox ui:ControlHelper.Header="Nota / CC / Programma / Valore" Text="{Binding Data1}"
                             Visibility="{Binding Kind, Converter={StaticResource EnumMatch}, ConverterParameter='NoteOn,NoteOff,ControlChange,ProgramChange,PitchBend'}" />
                    <TextBox ui:ControlHelper.Header="Velocity / Valore CC" Text="{Binding Data2}"
                             Visibility="{Binding Kind, Converter={StaticResource EnumMatch}, ConverterParameter='NoteOn,NoteOff,ControlChange'}" />
                    <TextBox ui:ControlHelper.Header="Byte SysEx (esadecimale)" Text="{Binding SysExHex}" Width="424"
                             Visibility="{Binding Kind, Converter={StaticResource EnumMatch}, ConverterParameter='SysEx'}" />
                </WrapPanel>
                <StackPanel Visibility="{Binding Kind, Converter={StaticResource EnumMatch}, ConverterParameter='ShowControl'}">
                    <WrapPanel>
                        <ComboBox ui:ControlHelper.Header="Comando MSC" ItemsSource="{x:Static c:EnumSources.MscCommands}"
                                  SelectedItem="{Binding MscCommand}" />
                        <TextBox ui:ControlHelper.Header="Device ID (127 = tutti)" Text="{Binding MscDeviceId}" />
                        <TextBox ui:ControlHelper.Header="Numero cue" Text="{Binding MscCueNumber}" />
                        <TextBox ui:ControlHelper.Header="Cue list" Text="{Binding MscCueList}" />
                        <TextBox ui:ControlHelper.Header="Command format" Text="{Binding MscCommandFormat}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Command format: 1 luci · 16 suono · 48 macchinari · 64 video · 127 tutti" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageNetwork">
            <StackPanel>
                <WrapPanel>
                    <ComboBox ui:ControlHelper.Header="Protocollo" ItemsSource="{x:Static c:EnumSources.NetworkProtocols}"
                              SelectedItem="{Binding Protocol}" ItemTemplate="{StaticResource EnumItem}" />
                    <TextBox ui:ControlHelper.Header="Host / IP" Text="{Binding Host}" />
                    <TextBox ui:ControlHelper.Header="Porta" Text="{Binding Port}" />
                    <TextBox ui:ControlHelper.Header="Indirizzo OSC" Text="{Binding OscAddress}"
                             Visibility="{Binding Protocol, Converter={StaticResource EnumMatch}, ConverterParameter='OscUdp,OscTcp'}" />
                    <TextBox ui:ControlHelper.Header="Argomenti" Text="{Binding OscArguments}" Width="424"
                             Visibility="{Binding Protocol, Converter={StaticResource EnumMatch}, ConverterParameter='OscUdp,OscTcp'}" />
                    <TextBox ui:ControlHelper.Header="Messaggio" Text="{Binding Payload}" AcceptsReturn="False" Width="424"
                             Visibility="{Binding Protocol, Converter={StaticResource EnumMatch}, ConverterParameter='Udp,Tcp'}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" Text="1 int · 0.5 float · true/false bool · &quot;testo&quot; string"
                           Visibility="{Binding Protocol, Converter={StaticResource EnumMatch}, ConverterParameter='OscUdp,OscTcp'}" />
                <TextBlock Style="{StaticResource Hint}" Text="Escape: \r \n \t \0 \\ \xHH"
                           Visibility="{Binding Protocol, Converter={StaticResource EnumMatch}, ConverterParameter='Udp,Tcp'}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageWait">
            <WrapPanel>
                <TextBox ui:ControlHelper.Header="Durata (s)" Text="{Binding WaitDuration}" />
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageFade">
            <WrapPanel>
                <TextBox ui:ControlHelper.Header="Cue target (numero)" Text="{Binding TargetNumber}" />
                <TextBox ui:ControlHelper.Header="Durata (s)" Text="{Binding FadeDuration}" />
                <CheckBox Content="Stop a fine fade" IsChecked="{Binding StopWhenDone}" />
                <CheckBox Content="Fade volume" IsChecked="{Binding FadeVolume}" />
                <TextBox ui:ControlHelper.Header="Volume finale (dB, -60 = muto)" Text="{Binding TargetVolumeDb}" />
                <CheckBox Content="Fade opacità (video/immagini)" IsChecked="{Binding FadeOpacity}" />
                <TextBox ui:ControlHelper.Header="Opacità finale (0–1)" Text="{Binding TargetOpacity}" />
            </WrapPanel>
        </DataTemplate>

        <DataTemplate x:Key="PageStop">
            <WrapPanel>
                <TextBox ui:ControlHelper.Header="Cue target (vuoto = tutte)" Text="{Binding TargetNumber}" />
                <TextBox ui:ControlHelper.Header="Fade out (s)" Text="{Binding FadeTime}" />
            </WrapPanel>
        </DataTemplate>

        <!-- ======================= In esecuzione: one row per running cue, QLab style ======================= -->
        <DataTemplate x:Key="RunningRow">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The bar: the fill follows the cue; paused, a click or drag scrubs it. -->
                <Border x:Name="Bar" Height="44" Background="{StaticResource ControlBrush}" CornerRadius="{StaticResource RadiusControl}"
                        ClipToBounds="True" Cursor="Arrow"
                        MouseLeftButtonDown="OnRunningBarDown" MouseMove="OnRunningBarMove" MouseLeftButtonUp="OnRunningBarUp">
                    <Grid>
                        <Rectangle x:Name="Fill" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5" Fill="{StaticResource RunningFillBrush}">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Progress}" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <!-- Cues without an end (loop, capture, held image): no position, the whole bar shows they are on. -->
                        <Rectangle x:Name="EndlessFill" Fill="{StaticResource EndlessFillBrush}" Visibility="Collapsed" />

                        <Grid Margin="12,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Border Style="{StaticResource Badge}" Padding="4,0" Margin="0,0,8,0" Background="{StaticResource ClipBrush}"
                                        VerticalAlignment="Center" Visibility="{Binding Clipped, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="CLIP" Style="{StaticResource BadgeText}" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextOnAccentBrush}" />
                                </Border>
                                <!-- Length and time left. -->
                                <TextBlock x:Name="Duration" Text="{Binding RuntimeDurationText}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSmall}"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" ToolTip="Durata" />
                                <TextBlock Text="{Binding RemainingText}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                                           MinWidth="72" TextAlignment="Right" VerticalAlignment="Center" ToolTip="Mancante" />
                            </StackPanel>
                        </Grid>

                        <!-- Level of an audio cue, along the bottom edge. -->
                        <ctl:LevelMeter Height="3" SegmentWidth="3" Level="{Binding MeterDb}" VerticalAlignment="Bottom" Margin="12,0,10,4"
                                        Visibility="{Binding TypeName, Converter={StaticResource EnumMatch}, ConverterParameter='Audio'}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button Margin="0,0,4,0" Width="{StaticResource CompactControlHeight}" Padding="0"
                            ctl:ButtonIcon.Brush="{StaticResource PausedBrush}"
                            Command="{Binding DataContext.TogglePauseCueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                                <Setter Property="ctl:ButtonIcon.Glyph" Value="{StaticResource IconPause}" />
                                <Setter Property="ToolTip" Value="Pausa" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RunState}" Value="Paused">
                                        <Setter Property="ctl:ButtonIcon.Glyph" Value="{StaticResource IconPlay}" />
                                        <Setter Property="ToolTip" Value="Riprendi" />
                                        <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource CompactButton}" Width="{StaticResource CompactControlHeight}" Padding="0" Margin="0,0,4,0"
                            ctl:ButtonIcon.Shape="{StaticResource IconFadeOutShape}" ctl:ButtonIcon.Brush="{StaticResource PausedBrush}"
                            ToolTip="Fade out"
                            Command="{Binding DataContext.FadeCueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource CompactButton}" Width="{StaticResource CompactControlHeight}" Padding="0"
                            ctl:ButtonIcon.Glyph="{StaticResource IconStop}" ctl:ButtonIcon.Brush="{StaticResource ErrorBrush}"
                            ToolTip="Stop"
                            Command="{Binding DataContext.StopCueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RuntimeDuration}" Value="{x:Null}">
                    <Setter TargetName="Fill" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EndlessFill" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Duration" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunState}" Value="PreWait">
                    <Setter TargetName="Fill" Property="Fill" Value="{StaticResource PreWaitFillBrush}" />
                    <Setter TargetName="EndlessFill" Property="Fill" Value="{StaticResource PreWaitFillBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFadingOut}" Value="True">
                    <Setter TargetName="Fill" Property="Fill" Value="{StaticResource FadingFillBrush}" />
                    <Setter TargetName="EndlessFill" Property="Fill" Value="{StaticResource FadingFillBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunState}" Value="Paused">
                    <Setter TargetName="Fill" Property="Fill" Value="{StaticResource PausedFillBrush}" />
                    <Setter TargetName="EndlessFill" Property="Fill" Value="{StaticResource PausedFillBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanSeek}" Value="True">
                    <Setter TargetName="Bar" Property="Cursor" Value="SizeWE" />
                    <Setter TargetName="Bar" Property="ToolTip" Value="Scorri" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunState}" Value="Error">
                    <Setter TargetName="Bar" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                    <Setter TargetName="Bar" Property="BorderThickness" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <DockPanel>
        <!-- ======================= Menu ======================= -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Nuovo" InputGestureText="{Binding ShortcutText[New]}" Command="{Binding NewCommand}" />
                <MenuItem Header="_Apri…" InputGestureText="{Binding ShortcutText[Open]}" Command="{Binding OpenCommand}" />
                <MenuItem Header="_Salva" InputGestureText="{Binding ShortcutText[Save]}" Command="{Binding SaveCommand}" />
                <MenuItem Header="Salva _con nome…" InputGestureText="{Binding ShortcutText[SaveAs]}" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="_Esci" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Cue">
                <MenuItem Header="Nuova cue Audio" Command="{Binding AddCueCommand}" CommandParameter="audio" />
                <MenuItem Header="Nuova cue Video" Command="{Binding AddCueCommand}" CommandParameter="video" />
                <MenuItem Header="Nuova cue Immagine" Command="{Binding AddCueCommand}" CommandParameter="image" />
                <MenuItem Header="Nuova cue Cattura" Command="{Binding AddCueCommand}" CommandParameter="live" />
                <MenuItem Header="Nuova cue MIDI" Command="{Binding AddCueCommand}" CommandParameter="midi" />
                <MenuItem Header="Nuova cue Rete (OSC/UDP/TCP)" Command="{Binding AddCueCommand}" CommandParameter="network" />
                <MenuItem Header="Nuova cue Attesa" Command="{Binding AddCueCommand}" CommandParameter="wait" />
                <MenuItem Header="Nuova cue Fade" Command="{Binding AddCueCommand}" CommandParameter="fade" />
                <MenuItem Header="Nuova cue Stop" Command="{Binding AddCueCommand}" CommandParameter="stop" />
                <Separator />
                <MenuItem Header="Duplica" InputGestureText="{Binding ShortcutText[Duplicate]}" Command="{Binding DuplicateCueCommand}" />
                <MenuItem Header="Sposta su" InputGestureText="{Binding ShortcutText[MoveUp]}" Command="{Binding MoveUpCommand}" />
                <MenuItem Header="Sposta giù" InputGestureText="{Binding ShortcutText[MoveDown]}" Command="{Binding MoveDownCommand}" />
                <MenuItem Header="Elimina" InputGestureText="{Binding ShortcutText[Delete]}" Command="{Binding DeleteCueCommand}" />
            </MenuItem>
            <MenuItem Header="_Show">
                <MenuItem Header="GO" InputGestureText="{Binding ShortcutText[Go]}" Command="{Binding GoCommand}" />
                <MenuItem Header="Avvia cue selezionata" InputGestureText="{Binding ShortcutText[FireSelected]}" Command="{Binding FireSelectedCommand}" />
                <MenuItem Header="Pausa / Riprendi" InputGestureText="{Binding ShortcutText[PauseResume]}" Command="{Binding TogglePauseCommand}" />
                <MenuItem Header="Fade out della cue selezionata" InputGestureText="{Binding ShortcutText[FadeSelected]}" Command="{Binding FadeSelectedCommand}" />
                <MenuItem Header="Stop" InputGestureText="{Binding ShortcutText[Panic]}" Command="{Binding PanicCommand}" />
                <MenuItem Header="E-STOP" InputGestureText="{Binding ShortcutText[StopAll]}" Command="{Binding StopAllCommand}" />
            </MenuItem>
            <MenuItem Header="_Visualizza">
                <MenuItem Header="Mostra / comprimi Proprietà cue" Command="{Binding ToggleInspectorCommand}"
                          InputGestureText="{Binding ShortcutText[ToggleInspector]}" />
                <MenuItem Header="Timeline" IsCheckable="True" IsChecked="{Binding IsTimelineVisible, Mode=TwoWay}"
                          InputGestureText="{Binding ShortcutText[ToggleTimeline]}" />
                <MenuItem Header="In esecuzione" IsCheckable="True" IsChecked="{Binding IsRunningPanelVisible, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="Colonne della lista">
                    <MenuItem Header="Destinazione" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[target], Mode=TwoWay}" />
                    <MenuItem Header="Route video" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[videoRoute], Mode=TwoWay}" />
                    <MenuItem Header="Route audio" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[audioRoute], Mode=TwoWay}" />
                    <MenuItem Header="Volume" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[volume], Mode=TwoWay}" />
                    <MenuItem Header="Opacità" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[opacity], Mode=TwoWay}" />
                    <MenuItem Header="Layer" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[layer], Mode=TwoWay}" />
                    <MenuItem Header="Pre-wait" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[prewait], Mode=TwoWay}" />
                    <MenuItem Header="Durata" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[duration], Mode=TwoWay}" />
                    <MenuItem Header="Post-wait" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[postwait], Mode=TwoWay}" />
                    <MenuItem Header="Fade in" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[fadeIn], Mode=TwoWay}" />
                    <MenuItem Header="Fade out" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[fadeOut], Mode=TwoWay}" />
                    <MenuItem Header="Loop" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[loop], Mode=TwoWay}" />
                    <MenuItem Header="Follow" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[continue], Mode=TwoWay}" />
                    <MenuItem Header="Link" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[link], Mode=TwoWay}" />
                    <MenuItem Header="Armata" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[armed], Mode=TwoWay}" />
                    <MenuItem Header="Note" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[notes], Mode=TwoWay}" />
                    <MenuItem Header="Stato (avanzamento)" IsCheckable="True" StaysOpenOnClick="True" IsChecked="{Binding Columns[state], Mode=TwoWay}" />
                    <Separator />
                    <MenuItem Header="Ripristina le colonne predefinite" Command="{Binding ResetColumnsCommand}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Strumenti">
                <MenuItem Header="Modalità Safe" IsCheckable="True"
                          IsChecked="{Binding IsSafeMode, Mode=TwoWay}" InputGestureText="{Binding ShortcutText[ToggleSafe]}" />
                <Separator />
                <MenuItem Header="Show Check…" InputGestureText="{Binding ShortcutText[ShowCheck]}" Command="{Binding ShowCheckCommand}" />
                <MenuItem Header="Log…" Command="{Binding OpenLogCommand}" />
                <Separator />
                <MenuItem Header="Impostazioni…" Click="OnSettingsClick" IsEnabled="{Binding CanEdit}" />
                <Separator />
                <MenuItem Header="Cerca aggiornamenti…" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding CanEdit}" />
                <MenuItem Header="{Binding VersionText}" IsEnabled="False" />
                <MenuItem Header="Route audio…" Click="OnSetupTabClick" Tag="3" IsEnabled="{Binding CanEdit}" />
                <MenuItem Header="Route video…" Click="OnSetupTabClick" Tag="4" IsEnabled="{Binding CanEdit}" />
                <!-- <MenuItem Header="Test pattern video…" Click="OnSetupTabClick" Tag="5" IsEnabled="{Binding CanEdit}" />
                <MenuItem Header="Test tone e rumore rosa…" Click="OnSetupTabClick" Tag="6" IsEnabled="{Binding CanEdit}" />
                <MenuItem Header="Scorciatoie da tastiera…" Click="OnSetupTabClick" Tag="7" IsEnabled="{Binding CanEdit}" /> -->
                <MenuItem Header="Aggiorna dispositivi" Command="{Binding RefreshDevicesCommand}" />
                <MenuItem Header="Chiudi uscite video" Command="{Binding CloseOutputsCommand}" />
            </MenuItem>
        </Menu>

        <!-- ======================= Transport: the show-critical strip ======================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource RaisedBrush}" Padding="16,12"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="GO" Command="{Binding GoCommand}" Style="{StaticResource GoButton}"
                    Width="136" Height="76" ToolTip="{Binding ShortcutHint[Go], Converter={StaticResource Format}, ConverterParameter='GO ({0})'}" />

            <!-- Next cue -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PROSSIMA CUE" Style="{StaticResource SectionHeaderFirst}" Margin="0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                            Background="{Binding SelectedCue.TypeName, Converter={StaticResource TypeBackground}}"
                            Visibility="{Binding SelectedCue, Converter={StaticResource NotEmpty}}">
                        <TextBlock Text="{Binding SelectedCue.TypeName}" Style="{StaticResource BadgeText}"
                                   Foreground="{Binding SelectedCue.TypeName, Converter={StaticResource TypeForeground}}" />
                    </Border>
                    <!-- Safe mode: editing locked for the show. -->
                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{StaticResource InfoTintBrush}"
                            ToolTip="Modalità Safe: modifiche bloccate"
                            Visibility="{Binding IsSafeMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="{StaticResource FontCaption}" Text="{StaticResource IconLock}"
                                       Foreground="{StaticResource SafeBrush}" Margin="0,0,4,0" />
                            <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource SafeBrush}" Text="SAFE" />
                        </StackPanel>
                    </Border>
                    <!-- Shown when the window loses focus: keyboard GO/Panic don't reach NewQ. -->
                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{StaticResource WarningTintBrush}"
                            ToolTip="I tasti vanno a un'altra finestra"
                            Visibility="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="{StaticResource FontCaption}" Text="{StaticResource IconWarning}"
                                       Foreground="{StaticResource WarningBrush}" Margin="0,0,4,0" />
                            <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource WarningBrush}"
                                       Text="TASTIERA NON ATTIVA" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                           FontFamily="{StaticResource DisplayFont}">
                    <Run Text="{Binding SelectedCue.Number, Mode=OneWay, FallbackValue='—'}" Foreground="{StaticResource PlayheadBrush}" />
                    <Run Text=" " />
                    <Run Text="{Binding SelectedCue.Name, Mode=OneWay, FallbackValue='Fine della lista'}" />
                </TextBlock>
                <TextBlock Text="{Binding SelectedCue.Notes, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" FontSize="{StaticResource FontBody}"
                           Visibility="{Binding SelectedCue.Notes, Converter={StaticResource NotEmpty}}" />
            </StackPanel>

            <!-- Output meter: what reaches the sound card, after the master volume. -->
            <Grid Grid.Column="2" Width="240" VerticalAlignment="Center" Margin="0,0,24,0"
                  ToolTip="Uscita audio (dBFS)">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="L" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <ctl:LevelMeter Grid.Column="1" Height="8" Margin="0,0,0,4"
                                Level="{Binding OutputLeftDb}" PeakHold="{Binding OutputPeakLeftDb}" />
                <TextBlock Grid.Row="1" Text="R" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <ctl:LevelMeter Grid.Row="1" Grid.Column="1" Height="8"
                                Level="{Binding OutputRightDb}" PeakHold="{Binding OutputPeakRightDb}" />
                <ctl:MeterScale Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" />

                <!-- 0 dBFS / clip indicator: latches red, click to reset (also resets the cues' clip markers). -->
                <Button Grid.Column="2" Grid.RowSpan="2" Margin="8,0,0,0" Width="44" Height="20" MinHeight="0"
                        Padding="0" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Focusable="False"
                        Command="{Binding ResetClipsCommand}"
                        ToolTip="Clip a 0 dBFS · clic per azzerare">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}">
                            <Setter Property="Content" Value="0 dB" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OutputClip}" Value="True">
                                    <Setter Property="Content" Value="CLIP" />
                                    <Setter Property="Background" Value="{StaticResource ClipBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource ClipBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Transport: neutral buttons, meaning carried by the glyph colour. -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding TogglePauseCommand}" Margin="0,0,8,0" ToolTip="{Binding ShortcutHint[PauseResume], Converter={StaticResource Format}, ConverterParameter='Pausa / riprendi tutto ({0})'}"
                        ctl:ButtonIcon.Brush="{StaticResource PausedBrush}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TransportButton}">
                            <Setter Property="Content" Value="Pausa" />
                            <Setter Property="ctl:ButtonIcon.Glyph" Value="{StaticResource IconPause}" />
                            <Style.Triggers>
                                <!-- Paused show: the button itself shows the state. -->
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Content" Value="Riprendi" />
                                    <Setter Property="ctl:ButtonIcon.Glyph" Value="{StaticResource IconPlay}" />
                                    <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Fade cue" Command="{Binding FadeSelectedCommand}" Style="{StaticResource TransportButton}" Margin="0,0,8,0"
                        ctl:ButtonIcon.Shape="{StaticResource IconFadeOutShape}" ctl:ButtonIcon.Brush="{StaticResource PausedBrush}"
                        ToolTip="{Binding ShortcutHint[FadeSelected], Converter={StaticResource Format}, ConverterParameter='Fade out della cue selezionata ({0})'}" />
                <Button Content="Stop" Command="{Binding PanicCommand}" AutomationProperties.AutomationId="TransportStop" Style="{StaticResource TransportButton}" Margin="0,0,8,0"
                        ctl:ButtonIcon.Glyph="{StaticResource IconStop}" ctl:ButtonIcon.Brush="{StaticResource ErrorBrush}"
                        ToolTip="{Binding ShortcutHint[Panic], Converter={StaticResource Format}, ConverterParameter='Fade out di tutto · due volte = immediato ({0})'}" />
                <Button Content="E-STOP" Command="{Binding StopAllCommand}" AutomationProperties.AutomationId="TransportEStop" Style="{StaticResource TransportButton}"
                        BorderBrush="{StaticResource ErrorBrush}"
                        ctl:ButtonIcon.Glyph="{StaticResource IconWarning}" ctl:ButtonIcon.Brush="{StaticResource ErrorBrush}"
                        ToolTip="{Binding ShortcutHint[StopAll], Converter={StaticResource Format}, ConverterParameter='Ferma subito tutto ({0})'}" />
            </StackPanel>
        </Grid>
        </Border>

        <!-- ======================= Toolbar ======================= -->
        <Border DockPanel.Dock="Top" Padding="{StaticResource ToolbarPadding}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="Show Check" Command="{Binding ShowCheckCommand}"
                            ctl:ButtonIcon.Glyph="{StaticResource IconShowCheck}" ToolTip="{Binding ShortcutHint[ShowCheck], Converter={StaticResource Format}, ConverterParameter='Rundown virtuale a buio e in muto ({0})'}" />
                    <ToggleButton Style="{StaticResource SubtleToggle}" Content="Safe" IsChecked="{Binding IsSafeMode, Mode=TwoWay}"
                                  ctl:ButtonIcon.Glyph="{StaticResource IconLock}" MinHeight="{StaticResource ControlHeight}"
                                  ToolTip="{Binding ShortcutHint[ToggleSafe], Converter={StaticResource Format}, ConverterParameter='Modalità Safe ({0})'}" />
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource ToolButton}" Content="Audio" Command="{Binding AddCueCommand}" CommandParameter="audio"
                            ctl:ButtonIcon.Glyph="{StaticResource IconAudio}" ToolTip="Nuova cue audio" />
                    <Button Style="{StaticResource ToolButton}" Content="Video" Command="{Binding AddCueCommand}" CommandParameter="video"
                            ctl:ButtonIcon.Glyph="{StaticResource IconVideo}" ToolTip="Nuova cue video" />
                    <Button Style="{StaticResource ToolButton}" Content="Immagine" Command="{Binding AddCueCommand}" CommandParameter="image"
                            ctl:ButtonIcon.Glyph="{StaticResource IconImage}" ToolTip="Nuova cue immagine" />
                    <Button Style="{StaticResource ToolButton}" Content="Cattura" Command="{Binding AddCueCommand}" CommandParameter="live"
                            ctl:ButtonIcon.Glyph="{StaticResource IconLive}" ToolTip="Nuova cue cattura" />
                    <Button Style="{StaticResource ToolButton}" Content="MIDI" Command="{Binding AddCueCommand}" CommandParameter="midi"
                            ctl:ButtonIcon.Glyph="{StaticResource IconMidi}" ToolTip="Nuova cue MIDI" />
                    <Button Style="{StaticResource ToolButton}" Content="Rete" Command="{Binding AddCueCommand}" CommandParameter="network"
                            ctl:ButtonIcon.Glyph="{StaticResource IconNetwork}" ToolTip="Nuova cue di rete" />
                    <Button Style="{StaticResource ToolButton}" Content="Attesa" Command="{Binding AddCueCommand}" CommandParameter="wait"
                            ctl:ButtonIcon.Glyph="{StaticResource IconWait}" ToolTip="Nuova cue attesa" />
                    <Button Style="{StaticResource ToolButton}" Content="Fade" Command="{Binding AddCueCommand}" CommandParameter="fade"
                            ctl:ButtonIcon.Glyph="{StaticResource IconFade}" ToolTip="Nuova cue fade" />
                    <Button Style="{StaticResource ToolButton}" Content="Stop" Command="{Binding AddCueCommand}" CommandParameter="stop"
                            ctl:ButtonIcon.Glyph="{StaticResource IconStop}" ToolTip="Nuova cue stop" />
                    <Rectangle Style="{StaticResource ToolbarDivider}" />
                    <Button Style="{StaticResource ToolButton}" Content="Duplica" Command="{Binding DuplicateCueCommand}"
                            ctl:ButtonIcon.Glyph="{StaticResource IconCopy}" ToolTip="{Binding ShortcutHint[Duplicate], Converter={StaticResource Format}, ConverterParameter='Duplica la cue ({0})'}" />
                    <Button Style="{StaticResource ToolIconButton}" Command="{Binding MoveUpCommand}"
                            ctl:ButtonIcon.Glyph="{StaticResource IconUp}" ToolTip="{Binding ShortcutHint[MoveUp], Converter={StaticResource Format}, ConverterParameter='Sposta su ({0})'}" />
                    <Button Style="{StaticResource ToolIconButton}" Command="{Binding MoveDownCommand}"
                            ctl:ButtonIcon.Glyph="{StaticResource IconDown}" ToolTip="{Binding ShortcutHint[MoveDown], Converter={StaticResource Format}, ConverterParameter='Sposta giù ({0})'}" />
                    <Button Style="{StaticResource ToolButton}" Content="Elimina" Command="{Binding DeleteCueCommand}"
                            ctl:ButtonIcon.Glyph="{StaticResource IconDelete}" ToolTip="{Binding ShortcutHint[Delete], Converter={StaticResource Format}, ConverterParameter='Elimina la cue ({0})'}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ======================= Status bar ======================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource RaisedBrush}" Padding="12,4"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <DockPanel TextElement.FontSize="{StaticResource FontSmall}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <Ellipse>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOscListening}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding OscStatus}" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <Ellipse>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWebRemoteOn}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding WebStatus}" Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand"
                               ToolTip="{Binding WebAddressesText}" MouseLeftButtonUp="OnWebAddressClick" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <Ellipse>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAudioReady}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding AudioStatus}" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>

        <!-- ======================= Main area: list | in esecuzione, timeline, properties at the bottom (QLab style) ======================= -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition x:Name="TimelineSplitterRow" Height="5" />
                <RowDefinition x:Name="TimelineRow" Height="240" MinHeight="140" />
                <RowDefinition x:Name="InspectorSplitterRow" Height="5" />
                <RowDefinition x:Name="InspectorRow" Height="260" MinHeight="150" />
            </Grid.RowDefinitions>
        <Grid Background="{StaticResource PanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500" />
                <ColumnDefinition x:Name="RunningSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="RunningColumn" Width="380" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <!-- Cue list -->
                <DataGrid x:Name="CueGrid"
                          ItemsSource="{Binding Workspace.Cues}"
                          SelectedItem="{Binding SelectedCue, Mode=TwoWay}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" CanUserReorderColumns="False"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                          IsReadOnly="{Binding IsSafeMode}"
                          Background="Transparent" BorderThickness="0" RowHeight="34" Padding="4,0"
                          AllowDrop="{Binding CanEdit}" Drop="OnCueGridDrop" HorizontalScrollBarVisibility="Auto"
                          SelectionChanged="OnCueGridSelectionChanged" BeginningEdit="OnCueGridBeginningEdit">
                    <DataGrid.Resources>
                        <!-- Whole rows are selected: the white frame around the focused cell is noise. -->
                        <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
                    </DataGrid.Resources>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="MinHeight" Value="34" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                            <!-- Right click: select the cue and open its properties. -->
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnCueRowRightClick" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Armed}" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                                <!-- SHOW START / SHOW END markers: structure, not content. -->
                                <DataTrigger Binding="{Binding IsShowMarker}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RunState}" Value="Running">
                                    <Setter Property="Foreground" Value="{StaticResource RunningBrush}" />
                                    <Setter Property="Background" Value="{StaticResource RunningRowBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RunState}" Value="PreWait">
                                    <Setter Property="Foreground" Value="{StaticResource PreWaitBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RunState}" Value="Paused">
                                    <Setter Property="Foreground" Value="{StaticResource PausedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RunState}" Value="Error">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="32" MinWidth="32" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconPlayhead}" HorizontalAlignment="Center"
                                               Foreground="{StaticResource PlayheadBrush}" ToolTip="Playhead"
                                               Visibility="{Binding IsPlayhead, Converter={StaticResource BoolToVis}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="N." Binding="{Binding Number}" Width="56" MinWidth="56" FontWeight="SemiBold" />
                        <DataGridTemplateColumn Header="" Width="44" MinWidth="44" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" Padding="4,0" Background="{StaticResource ClipBrush}"
                                            Visibility="{Binding Clipped, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Clip a 0 dBFS">
                                        <TextBlock Text="CLIP" Style="{StaticResource BadgeText}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource TextOnAccentBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Tipo" Width="92" MinWidth="92" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}"
                                            Background="{Binding TypeName, Converter={StaticResource TypeBackground}}">
                                        <TextBlock Text="{Binding TypeName}" Style="{StaticResource BadgeText}"
                                                   Foreground="{Binding TypeName, Converter={StaticResource TypeForeground}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*" MinWidth="140" />
                        <DataGridTextColumn x:Name="ColTarget" Header="Destinazione" Binding="{Binding Summary, Mode=OneWay}" Width="2*" MinWidth="110" IsReadOnly="True" />
                        <!-- Optional columns (menu Visualizza → Colonne). Cues without the property show an empty cell. -->
                        <DataGridTextColumn x:Name="ColVideoRoute" Header="Route video" Width="1.2*" MinWidth="100" IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource RouteName}">
                                    <Binding Path="VideoRouteId" />
                                    <Binding Path="DataContext.Workspace.VideoRoutes" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="DataContext.RoutesVersion" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ColAudioRoute" Header="Route audio" Width="1.2*" MinWidth="100" IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource RouteName}">
                                    <Binding Path="AudioRouteId" />
                                    <Binding Path="DataContext.Workspace.AudioRoutes" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="DataContext.RoutesVersion" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ColVolume" Header="Volume" Binding="{Binding ListVolumeDb, StringFormat='0.# dB', TargetNullValue=''}" Width="80" MinWidth="80" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColOpacity" Header="Opacità" Binding="{Binding ListOpacity, StringFormat='0.##', TargetNullValue=''}" Width="76" MinWidth="76" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColLayer" Header="Layer" Binding="{Binding Layer, FallbackValue=''}" Width="60" MinWidth="60" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColPrewait" Header="Pre" Binding="{Binding PreWait, StringFormat='0.##'}" Width="52" MinWidth="52" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColDuration" Header="Durata" Binding="{Binding DurationText, Mode=OneWay}" Width="80" MinWidth="80" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColPostwait" Header="Post" Binding="{Binding PostWait, StringFormat='0.##'}" Width="52" MinWidth="52" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColFadeIn" Header="Fade in" Binding="{Binding FadeIn, StringFormat='0.##', FallbackValue=''}" Width="76" MinWidth="76" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColFadeOut" Header="Fade out" Binding="{Binding FadeOut, StringFormat='0.##', FallbackValue=''}" Width="80" MinWidth="80" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColLoop" Header="Loop" Binding="{Binding Loop, Converter={StaticResource CheckMark}, FallbackValue=''}" Width="60" MinWidth="60" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColContinue" Header="Follow" Binding="{Binding ContinueSymbol, Mode=OneWay}" Width="64" MinWidth="64" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColLink" Header="Link" Binding="{Binding LinkText, Mode=OneWay}" Width="64" MinWidth="64" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColArmed" Header="Armata" Binding="{Binding Armed, Converter={StaticResource CheckMark}}" Width="76" MinWidth="76" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColNotes" Header="Note" Binding="{Binding Notes}" Width="2*" MinWidth="120" IsReadOnly="True" />
                        <DataGridTemplateColumn x:Name="ColState" Header="Stato" Width="120" MinWidth="120" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="4,0"
                                                 VerticalAlignment="Center">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RunState}" Value="Idle">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RunState}" Value="Error">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" FontSize="{StaticResource FontTitle}"
                           Text="Trascina qui file audio, video o immagini">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProgramCues}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <GridSplitter x:Name="RunningSplitter" Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                          DragCompleted="OnRunningResized" />

            <!-- ======================= In esecuzione (Visualizza → In esecuzione) ======================= -->
            <DockPanel x:Name="RunningPanel" Grid.Column="2">
                <Border DockPanel.Dock="Top" Height="37" Padding="16,0,8,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="IN ESECUZIONE" Style="{StaticResource SectionHeaderFirst}" Margin="0" VerticalAlignment="Center" />
                </Border>
                <Grid>
                    <TextBlock Text="Nessuna cue in esecuzione" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveCues.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ActiveCues}" ItemTemplate="{StaticResource RunningRow}"
                                      Margin="8,8,8,4" Focusable="False" />
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>

        <GridSplitter x:Name="TimelineSplitter" Grid.Row="1" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                      Background="{StaticResource PanelBrush}" DragCompleted="OnTimelineResized" />
        <views:TimelinePanel x:Name="TimelineArea" Grid.Row="2" />

        <GridSplitter x:Name="InspectorSplitter" Grid.Row="3" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                      Background="{StaticResource PanelBrush}" DragCompleted="OnInspectorResized" />

        <!-- ======================= Inspector: the selected cue, one page per tab ======================= -->
        <Grid x:Name="InspectorPanel" Grid.Row="4" Background="{StaticResource PanelBrush}">
            <Grid.Resources>
                <!-- Form rhythm, scoped here so it doesn't affect the DataGrid's editing cells; fields flow in rows. -->
                <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
                    <Setter Property="Width" Value="208" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                </Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBox}">
                    <Setter Property="Width" Value="208" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                </Style>
                <Style TargetType="CheckBox" BasedOn="{StaticResource FormCheckBox}">
                    <Setter Property="MinWidth" Value="120" />
                    <Setter Property="Margin" Value="0,25,16,12" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Which cue: type, number, name; Safe mode and errors. -->
            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="16,12,12,12">
                <StackPanel>
                    <TextBlock Text="PROPRIETÀ CUE" Style="{StaticResource SectionHeaderFirst}" />
                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Background="{Binding SelectedCue.TypeName, Converter={StaticResource TypeBackground}}"
                            Visibility="{Binding SelectedCue, Converter={StaticResource NotEmpty}}">
                        <TextBlock Text="{Binding SelectedCue.TypeName}" Style="{StaticResource BadgeText}"
                                   Foreground="{Binding SelectedCue.TypeName, Converter={StaticResource TypeForeground}}" />
                    </Border>
                    <TextBlock FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
                               Visibility="{Binding SelectedCue, Converter={StaticResource NotEmpty}}">
                        <Run Text="{Binding SelectedCue.Number, Mode=OneWay}" Foreground="{StaticResource PlayheadBrush}" />
                        <Run Text="{Binding SelectedCue.Name, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="Nessuna cue selezionata" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCue}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Safe mode: fields are read-only. -->
                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Padding="8,4" Margin="0,12,0,0"
                            Background="{StaticResource InfoTintBrush}"
                            Visibility="{Binding IsSafeMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconLock}" Foreground="{StaticResource SafeBrush}"
                                       FontSize="{StaticResource FontSmall}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Foreground="{StaticResource SafeBrush}" FontSize="{StaticResource FontSmall}" Text="Sola lettura" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding SelectedCue.ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSmall}" Margin="0,12,0,0"
                               Visibility="{Binding SelectedCue.ErrorMessage, Converter={StaticResource NotEmpty}}" />
                </StackPanel>
            </Border>

            <!-- Pages of the selected cue (built by MainWindow.ShowInspectorPages). -->
            <TabControl x:Name="InspectorTabs" Grid.Column="1" Padding="0" Focusable="False"
                        Visibility="{Binding SelectedCue, Converter={StaticResource NotEmpty}}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Header}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ContentControl Content="{Binding Cue}" ContentTemplate="{Binding Template}" Focusable="False" Margin="16,12,8,0"
                                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </ScrollViewer>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <Button Grid.Column="1" Style="{StaticResource IconButton}" ctl:ButtonIcon.Glyph="&#xE70D;"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0"
                    Command="{Binding ToggleInspectorCommand}"
                    ToolTip="{Binding ShortcutHint[ToggleInspector], Converter={StaticResource Format}, ConverterParameter='Comprimi le proprietà ({0})'}" />
        </Grid>
        </Grid>
    </DockPanel>

    <!-- Static amber frame while the window is not focused (draws over the content, never blocks clicks). -->
    <Border BorderBrush="{StaticResource WarningBrush}" BorderThickness="2" IsHitTestVisible="False"
            Visibility="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}" />
    </Grid>
</Window>
