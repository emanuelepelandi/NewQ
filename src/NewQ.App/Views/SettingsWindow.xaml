<Window x:Class="NewQ.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:setup="clr-namespace:NewQ.App.Views.Setup"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Impostazioni" Width="1100" Height="780" MinWidth="900" MinHeight="560"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <!-- Form rhythm for every page of the window. -->
        <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBox}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource FormCheckBox}" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl x:Name="Tabs" Padding="16,0">
            <TabItem Header="Generale">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,16,24,24" HorizontalAlignment="Left" Width="560">
                    <TextBlock Text="AUDIO" Style="{StaticResource SectionHeaderFirst}" />
                    <ComboBox x:Name="DriverBox" ui:ControlHelper.Header="Driver" SelectionChanged="OnDriverChanged">
                        <ComboBoxItem Content="WASAPI (Windows, consigliato)" Tag="Wasapi" />
                        <ComboBoxItem Content="ASIO (interfacce audio professionali)" Tag="Asio" />
                    </ComboBox>

                    <StackPanel x:Name="WasapiPanel">
                        <ComboBox x:Name="WasapiDeviceBox" ui:ControlHelper.Header="Dispositivo di uscita" DisplayMemberPath="Name" />
                        <UniformGrid Columns="2">
                            <TextBox x:Name="LatencyBox" ui:ControlHelper.Header="Latenza (ms)" />
                            <CheckBox x:Name="ExclusiveBox" Content="Modalità esclusiva" VerticalAlignment="Bottom" />
                        </UniformGrid>
                    </StackPanel>

                    <StackPanel x:Name="AsioPanel">
                        <ComboBox x:Name="AsioDriverBox" ui:ControlHelper.Header="Driver ASIO" />
                        <UniformGrid Columns="2">
                            <TextBox x:Name="SampleRateBox" ui:ControlHelper.Header="Frequenza (Hz)" />
                            <TextBlock Text="I canali di uscita si scelgono in ogni route audio." Style="{StaticResource Hint}" VerticalAlignment="Bottom" Margin="0,0,8,16" />
                        </UniformGrid>
                    </StackPanel>

                    <TextBox x:Name="MasterBox" ui:ControlHelper.Header="Volume master (dB)" />

                    <TextBlock Text="MIDI" Style="{StaticResource SectionHeader}" />
                    <ComboBox x:Name="MidiBox" ui:ControlHelper.Header="Uscita MIDI predefinita" IsEditable="True" />

                    <TextBlock Text="CONTROLLO REMOTO OSC" Style="{StaticResource SectionHeader}" />
                    <UniformGrid Columns="2">
                        <CheckBox x:Name="OscEnabledBox" Content="Ricevi comandi OSC" VerticalAlignment="Bottom" />
                        <TextBox x:Name="OscPortBox" ui:ControlHelper.Header="Porta UDP" />
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Comandi compatibili QLab: /go, /stop, /panic, /pause, /resume, /playhead/next, /playhead/previous, /cue/{numero}/start, /cue/{numero}/stop." />

                    <TextBlock Text="WORKSPACE CORRENTE" Style="{StaticResource SectionHeader}" />
                    <UniformGrid Columns="2">
                        <TextBox x:Name="PanicFadeBox" ui:ControlHelper.Header="Fade del Panic (s)" />
                        <TextBox x:Name="LockoutBox" ui:ControlHelper.Header="Blocco doppio GO (ms)" />
                    </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Route audio">
                <setup:AudioRoutesPanel x:Name="AudioRoutesPage" />
            </TabItem>
            <TabItem Header="Route video">
                <setup:VideoRoutesPanel x:Name="VideoRoutesPage" />
            </TabItem>
            <TabItem Header="Test video">
                <setup:TestVideoPanel x:Name="TestVideoPage" />
            </TabItem>
            <TabItem Header="Test audio">
                <setup:TestAudioPanel x:Name="TestAudioPage" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <TextBlock Text="Route e test si applicano subito. OK / Annulla riguardano solo la scheda Generale."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSmall}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annulla" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
                    <Button Content="OK" IsDefault="True" MinWidth="100" Click="OnOk" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
