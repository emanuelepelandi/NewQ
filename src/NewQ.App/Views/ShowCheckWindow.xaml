<Window x:Class="NewQ.App.Views.ShowCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Show Check" Width="920" Height="640" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Show Check" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" />
            <TextBlock Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{StaticResource FontSmall}"
                       Text="Rundown virtuale a buio e in muto: file e percorsi, formati, livelli audio, uscite, dispositivi e logica delle cue." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="16,12" Margin="0,16,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ShowInfoBox" Content="Mostra informazioni" IsChecked="True" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="SummaryText" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Text="Controllo in corso…" />
                    <ProgressBar x:Name="Progress" Maximum="1" Height="4" Margin="0,8,24,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="4">
            <Grid>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="{StaticResource FontTitle}" Foreground="{StaticResource SuccessBrush}" Text="Nessun problema trovato: lo show è pronto." />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IssueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" CornerRadius="{StaticResource RadiusControl}" Margin="0,1"
                                        MouseLeftButtonDown="OnIssueClick" ToolTip="Doppio clic per selezionare la cue">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Badge}" VerticalAlignment="Top" Background="{Binding BadgeBackground}">
                                            <TextBlock Text="{Binding SeverityLabel}" Style="{StaticResource BadgeText}" Foreground="{Binding BadgeForeground}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding CueLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Top" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RerunButton" Content="Ricontrolla" MinWidth="112" Margin="0,0,8,0" Click="OnRerun" />
            <Button Content="Chiudi" MinWidth="112" IsCancel="True" Click="OnClose" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
