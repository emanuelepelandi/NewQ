<Window x:Class="NewQ.App.Views.ShowCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Show Check" Width="920" Height="640" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Show Check" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
            <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Rundown virtuale a buio e in muto: file e percorsi, formati, livelli audio, uscite, dispositivi e logica delle cue." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,14,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ShowInfoBox" Content="Mostra informazioni" IsChecked="True" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold" Text="Controllo in corso…" />
                    <ProgressBar x:Name="Progress" Maximum="1" Height="4" Margin="0,8,24,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="15" Foreground="{StaticResource RunningBrush}" Text="✔  Nessun problema trovato: lo show è pronto." />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IssueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,7" CornerRadius="6" Margin="0,1" Cursor="Hand" Background="Transparent"
                                        MouseLeftButtonDown="OnIssueClick" ToolTip="Doppio clic per selezionare la cue">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{Binding BadgeBackground}">
                                            <TextBlock Text="{Binding SeverityLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding CueLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Top" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource SoftTextBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RerunButton" Content="Ricontrolla" MinWidth="110" Margin="0,0,8,0" Click="OnRerun" ui:ControlHelper.CornerRadius="6" />
            <Button Content="Chiudi" MinWidth="110" IsCancel="True" Click="OnClose" Style="{StaticResource PrimaryButton}" ui:ControlHelper.CornerRadius="6" />
        </StackPanel>
    </Grid>
</Window>
