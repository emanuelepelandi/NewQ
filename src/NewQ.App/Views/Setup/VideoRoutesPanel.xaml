<UserControl x:Class="NewQ.App.Views.Setup.VideoRoutesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:ctl="clr-namespace:NewQ.App.Controls"
             xmlns:local="clr-namespace:NewQ.App.Views.Setup">
    <UserControl.Resources>
        <local:PercentConverter x:Key="Percent" />
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="SliderRow" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Routes and outputs -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="ROUTE VIDEO" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                <ListBox x:Name="RouteList" DisplayMemberPath="Name" SelectionChanged="OnRouteSelected" Background="Transparent" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="+ Route" Click="OnAddRoute" Margin="0,0,6,0" />
                <Button Content="Duplica" Click="OnDuplicateRoute" Margin="0,0,6,0" />
                <Button Content="Rimuovi" Click="OnRemoveRoute" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="USCITE DELLA ROUTE" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="4">
                <ListBox x:Name="OutputList" DisplayMemberPath="Name" SelectionChanged="OnOutputSelected" Background="Transparent" />
            </Border>
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="+ Uscita" Click="OnAddOutput" Margin="0,0,6,0" />
                <Button Content="Duplica" Click="OnDuplicateOutput" Margin="0,0,6,0" />
                <Button Content="Rimuovi" Click="OnRemoveOutput" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <!-- Route -->
                <StackPanel x:Name="RouteEditor">
                    <TextBlock Text="ROUTE" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Field}" ui:ControlHelper.Header="Nome" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" />
                        <TextBox Grid.Column="1" Style="{StaticResource Field}" ui:ControlHelper.Header="Canvas largh. (px)" Text="{Binding CanvasWidth}" VerticalAlignment="Top" />
                        <TextBox Grid.Column="2" Style="{StaticResource Field}" ui:ControlHelper.Header="Canvas alt. (px)" Text="{Binding CanvasHeight}" VerticalAlignment="Top" />
                    </Grid>
                    <WrapPanel Margin="0,0,0,4">
                        <ToggleButton x:Name="GridToggle" Content="Griglia di test su questa route" Click="OnGridToggle" Margin="0,0,8,6" />
                        <ToggleButton x:Name="IdentifyToggle" Content="Identifica uscite" Click="OnIdentifyToggle" Margin="0,0,8,6" />
                        <Button Content="Affianca uscite in blend" Click="OnTileOutputs" Margin="0,0,6,6" />
                        <TextBlock Text="sovrapposizione" VerticalAlignment="Center" Margin="0,0,6,6" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox x:Name="OverlapBox" Text="15" Width="56" Margin="0,0,4,6" ToolTip="Sovrapposizione tra uscite vicine, in % della larghezza di un'uscita" />
                        <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,8,6" />
                    </WrapPanel>
                </StackPanel>

                <!-- Output -->
                <StackPanel x:Name="OutputEditor">
                    <TextBlock Text="USCITA" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Field}" ui:ControlHelper.Header="Nome" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox x:Name="ScreenBox" Grid.Column="1" ui:ControlHelper.Header="Schermo / proiettore" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding ScreenIndex}"
                                  SelectionChanged="OnScreenChanged" Margin="0,0,8,8" />
                    </Grid>

                    <TextBlock Text="PORZIONE DEL CANVAS (%)" Style="{StaticResource SectionTitle}" Margin="0,8,0,6" />
                    <UniformGrid Columns="4">
                        <TextBox Style="{StaticResource Field}" ui:ControlHelper.Header="X" Text="{Binding SourceX, Converter={StaticResource Percent}}" />
                        <TextBox Style="{StaticResource Field}" ui:ControlHelper.Header="Y" Text="{Binding SourceY, Converter={StaticResource Percent}}" />
                        <TextBox Style="{StaticResource Field}" ui:ControlHelper.Header="Larghezza" Text="{Binding SourceWidth, Converter={StaticResource Percent}}" />
                        <TextBox Style="{StaticResource Field}" ui:ControlHelper.Header="Altezza" Text="{Binding SourceHeight, Converter={StaticResource Percent}}" />
                    </UniformGrid>

                    <TextBlock Text="POSIZIONE E SCALA SULLO SCHERMO (%)" Style="{StaticResource SectionTitle}" Margin="0,8,0,6" />
                    <UniformGrid Columns="4">
                        <TextBox Style="{StaticResource Field}" ui:ControlHelper.Header="X" Text="{Binding DestX, Converter={StaticResource Percent}}" />
                        <TextBox Style="{StaticResource Field}" ui:ControlHelper.Header="Y" Text="{Binding DestY, Converter={StaticResource Percent}}" />
                        <TextBox Style="{StaticResource Field}" ui:ControlHelper.Header="Larghezza" Text="{Binding DestWidth, Converter={StaticResource Percent}}" />
                        <TextBox Style="{StaticResource Field}" ui:ControlHelper.Header="Altezza" Text="{Binding DestHeight, Converter={StaticResource Percent}}" />
                    </UniformGrid>

                    <TextBlock Text="KEYSTONE E WARPING" Style="{StaticResource SectionTitle}" Margin="0,8,0,6" />
                    <Border Style="{StaticResource Card}" Padding="1" Height="340">
                        <ctl:GeometryEditor x:Name="Geometry" AutomationProperties.Name="Editor geometria" />
                    </Border>
                    <WrapPanel Margin="0,8,0,0">
                        <ui:NumberBox x:Name="WarpColumnsBox" Header="Warp colonne" Minimum="0" Maximum="8" SpinButtonPlacementMode="Inline"
                                      Value="{Binding WarpColumns}" Width="140" Margin="0,0,8,8" />
                        <ui:NumberBox x:Name="WarpRowsBox" Header="Warp righe" Minimum="0" Maximum="8" SpinButtonPlacementMode="Inline"
                                      Value="{Binding WarpRows}" Width="140" Margin="0,0,16,8" />
                        <Button Content="Azzera keystone" Click="OnResetKeystone" VerticalAlignment="Bottom" Margin="0,0,8,8" />
                        <Button Content="Azzera warp" Click="OnResetWarp" VerticalAlignment="Bottom" Margin="0,0,8,8" />
                    </WrapPanel>

                    <TextBlock Text="EDGE BLENDING" Style="{StaticResource SectionTitle}" Margin="0,8,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Sinistra" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource SliderRow}" Minimum="0" Maximum="0.5" SmallChange="0.005" LargeChange="0.05" Value="{Binding BlendLeft}" />
                        <TextBox Grid.Column="2" Text="{Binding BlendLeft, Converter={StaticResource Percent}}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Destra" VerticalAlignment="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource SliderRow}" Minimum="0" Maximum="0.5" SmallChange="0.005" LargeChange="0.05" Value="{Binding BlendRight}" />
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding BlendRight, Converter={StaticResource Percent}}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="Sopra" VerticalAlignment="Center" />
                        <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource SliderRow}" Minimum="0" Maximum="0.5" SmallChange="0.005" LargeChange="0.05" Value="{Binding BlendTop}" />
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding BlendTop, Converter={StaticResource Percent}}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Text="Sotto" VerticalAlignment="Center" />
                        <Slider Grid.Row="3" Grid.Column="1" Style="{StaticResource SliderRow}" Minimum="0" Maximum="0.5" SmallChange="0.005" LargeChange="0.05" Value="{Binding BlendBottom}" />
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding BlendBottom, Converter={StaticResource Percent}}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Text="Gamma" VerticalAlignment="Center" />
                        <Slider Grid.Row="4" Grid.Column="1" Style="{StaticResource SliderRow}" Minimum="1" Maximum="3.5" SmallChange="0.05" LargeChange="0.2" Value="{Binding BlendGamma}" />
                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding BlendGamma, StringFormat=0.00}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="5" Text="Curva" VerticalAlignment="Center" />
                        <Slider Grid.Row="5" Grid.Column="1" Style="{StaticResource SliderRow}" Minimum="1" Maximum="4" SmallChange="0.05" LargeChange="0.5" Value="{Binding BlendCurve}" />
                        <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding BlendCurve, StringFormat=0.00}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0"
                               Text="Il blend è una frazione dell'immagine di questa uscita. Per due proiettori sovrapposti usa «Affianca uscite in blend»: imposta porzioni del canvas e blend in modo coerente. Tutte le modifiche sono visibili subito sulle uscite." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
