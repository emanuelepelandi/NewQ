<UserControl x:Class="NewQ.App.Views.Setup.TestVideoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="INVIA ALLE ROUTE" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Tutte" Click="OnSelectAll" Margin="0,0,6,0" />
                    <Button Content="Nessuna" Click="OnSelectNone" />
                </StackPanel>
                <ToggleButton x:Name="IdentifyToggle" Content="Identifica uscite" Click="OnIdentify" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                <Button Content="Spegni tutti i test" Click="OnClearAll" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="8">
                <ItemsControl x:Name="RouteChecks">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Route.Name}" IsChecked="{Binding Selected}" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource RunningBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="TEST PATTERN" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <ItemsControl x:Name="Patterns">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OnPattern" Tag="{Binding Kind}" AutomationProperties.Name="{Binding Kind}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="12,8" Margin="0,0,8,8" MinHeight="64">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,8,0"
                           Text="Il pattern copre tutto ciò che è in onda sulla route, passando per geometria, warp ed edge blend delle sue uscite. Panic, la modalità Safe e la chiusura di questa finestra spengono tutti i test." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
