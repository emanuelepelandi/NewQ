<UserControl x:Class="NewQ.App.Views.Setup.GraphicsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:NewQ.App.Controls">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Ripristina tutti i predefiniti" Click="OnResetAll" VerticalAlignment="Top" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,24,0" Text="Colori di badge e timeline. Il verde indica l'avanzamento." />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ItemsControl x:Name="Rows" Margin="16,4,16,12" KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <StackPanel>
                            <TextBlock Text="TIPI DI CUE" Style="{StaticResource SectionHeader}" Margin="0,12,0,4" />
                            <ItemsPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <!-- Preview: the badge of the cue list. -->
                            <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{Binding Tint}">
                                <TextBlock Text="{Binding Type}" Style="{StaticResource BadgeText}" Foreground="{Binding Solid}" />
                            </Border>
                            <TextBox Grid.Column="2" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                                     FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="{Binding Label}" />
                            <Button Grid.Column="3" Style="{StaticResource SquareButton}" Margin="8,0,0,0" Click="OnPalette"
                                    ToolTip="Tavolozza" Padding="6">
                                <Border Background="{Binding Solid}" CornerRadius="{StaticResource RadiusBadge}"
                                        Width="18" Height="18" />
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource SquareButton}" Margin="4,0,0,0"
                                    ctl:ButtonIcon.Glyph="&#xE7A7;" Click="OnResetOne" ToolTip="Colore predefinito" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Palette of the swatch buttons. -->
        <Popup x:Name="Palette" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
            <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}" Padding="8">
                <ItemsControl x:Name="Swatches" Width="336">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="26" Height="26" Margin="1" Padding="0" MinWidth="0" MinHeight="0" Click="OnSwatch"
                                    Background="{Binding Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}" Focusable="True">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderThickness="1"
                                                BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{StaticResource RadiusBadge}" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>
