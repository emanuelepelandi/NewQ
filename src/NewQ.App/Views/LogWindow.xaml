<Window x:Class="NewQ.App.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="/Assets/NewQ.ico"
        Title="Log" Width="720" Height="480" MinWidth="400" MinHeight="240"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">
    <!-- Newest first (the view model inserts at the top). -->
    <ListBox ItemsSource="{Binding Log}" Background="Transparent" Padding="8,4"
             AutomationProperties.Name="Log">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontSmall}">
                    <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFont}" />
                    <Run Text="{Binding Level, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding Message, Mode=OneWay}" />
                </TextBlock>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</Window>
