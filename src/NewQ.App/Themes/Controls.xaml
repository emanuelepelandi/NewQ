<!--
    NewQ shared control styles, built on the tokens (Tokens.xaml) and on ModernWpfUI.
    Flat surfaces, hairline borders, small radii, no gradients and no decorative animation.
    Every interactive control shows hover, pressed, keyboard focus, disabled and (toggles) checked states.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.modernwpf.com/2019"
                    xmlns:ctl="clr-namespace:NewQ.App.Controls">
    <!-- The tokens are merged here too, so this dictionary resolves them on its own. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===================================================================== Text -->

    <!-- Section heading inside a panel or form: small caps-like caption. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>
    <!-- First heading of a panel: no space above. -->
    <Style x:Key="SectionHeaderFirst" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Explanatory text under a group of controls. -->
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,8,12" />
    </Style>

    <!-- A glyph from the icon font. -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontIcon}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================================================================== Containers -->

    <!-- A bounded group (lists in the setup pages, the issue list...). Use sparingly: no card soup. -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
    </Style>

    <!-- Recessed surface for technical editors and previews. -->
    <Style x:Key="InsetPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
    </Style>

    <!-- Compact state label (cue type, SAFE, CLIP, severity). -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBadge}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Status light in the status bar. -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Vertical divider between toolbar groups. -->
    <Style x:Key="ToolbarDivider" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Fill" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="Margin" Value="8,4" />
    </Style>

    <!-- ===================================================================== Buttons -->

    <!--
        One template for every button: flat fill, hairline border, optional icon (ctl:ButtonIcon.Glyph),
        light overlay on hover, dark overlay when pressed, accent ring for keyboard focus.
    -->
    <ControlTemplate x:Key="NewQButtonTemplate" TargetType="ButtonBase">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusControl}" />
            <Border x:Name="Overlay" CornerRadius="{StaticResource RadiusControl}" Background="Transparent" />
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Margin="0,0,8,0"
                           Text="{Binding (ctl:ButtonIcon.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                           Foreground="{Binding (ctl:ButtonIcon.Brush), RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter x:Name="Label" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </StackPanel>
            <Border x:Name="FocusRing" Margin="-3" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}"
                    CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ctl:ButtonIcon.Glyph" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ctl:ButtonIcon.Brush" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Foreground"
                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Glyph" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Overlay" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Overlay" Property="Background" Value="{StaticResource PressOverlayBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Default (secondary) button. Implicit: every Button in the app. -->
    <Style x:Key="ButtonBaseStyle" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource NewQButtonTemplate}" />
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
    <Style x:Key="DefaultButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}" />
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}" />

    <!-- The one primary action of a dialog or page (OK, Avvia). -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Toolbar and inline actions: no chrome until hovered. -->
    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Focusable" Value="False" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Square icon-only button (always give it a ToolTip). -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <!-- Icon-only: screen readers and UI automation read the tooltip as the name. -->
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Width" Value="{StaticResource ControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Square bordered icon button (list actions: duplicate, remove). Always give it a ToolTip. -->
    <Style x:Key="SquareButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
        <!-- Icon-only: screen readers and UI automation read the tooltip as the name. -->
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Width" Value="{StaticResource ControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Small neutral button inside list rows (per-cue pause/stop). -->
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
        <!-- Icon-only: screen readers and UI automation read the tooltip as the name. -->
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="MinHeight" Value="{StaticResource CompactControlHeight}" />
        <Setter Property="Height" Value="{StaticResource CompactControlHeight}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- GO: the one strongly coloured control of the application. -->
    <Style x:Key="GoButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
        <Setter Property="Background" Value="{StaticResource GoBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GoPressedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Focusable" Value="False" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GoHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Show transport (Pausa, Stop tutto, Panic): neutral buttons, the meaning carried by a coloured glyph
        (ctl:ButtonIcon.Brush). Distinguishable without dominating the GO.
    -->
    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Toggle (Safe, grid on route, identify outputs): checked = accent tint + accent border. -->
    <Style x:Key="ToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ButtonBaseStyle}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleStyle}" />

    <!-- Toolbar toggle: subtle until checked. -->
    <Style x:Key="SubtleToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Focusable" Value="False" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== Inputs -->

    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>

    <!-- Form fields: the standard vertical rhythm of property forms (inspector, settings). -->
    <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Margin" Value="{StaticResource FieldMargin}" />
        <Setter Property="ui:ControlHelper.CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>
    <Style x:Key="FormComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Margin" Value="{StaticResource FieldMargin}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ui:ControlHelper.CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>
    <Style x:Key="FormCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="{StaticResource FieldMargin}" />
    </Style>

    <!-- ===================================================================== Tabs -->

    <!-- Text tabs with an accent underline: used for page navigation (settings) and panel switching. -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root" Background="Transparent" Height="36">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" RecognizesAccessKey="True" />
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="8,0"
                                Background="{StaticResource AccentBrush}" Visibility="Hidden" />
                        <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}"
                                CornerRadius="{StaticResource RadiusControl}" Margin="2,4" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabNavigation="Local" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Data grid -->

    <!-- ModernWpf theme brushes for the column headers: headers sit on the panel surface, no dark band. -->
    <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush" Color="{StaticResource ControlHoverColor}" />
    <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="{StaticResource ControlPressedColor}" />

    <!-- ===================================================================== Splitters -->

    <!-- 1 px divider line with a wider grab area. -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Line" Fill="{StaticResource BorderSubtleBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Fill" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="ResizeDirection" Value="Columns">
                            <Setter TargetName="Line" Property="Width" Value="1" />
                        </Trigger>
                        <Trigger Property="ResizeDirection" Value="Rows">
                            <Setter TargetName="Line" Property="Height" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
