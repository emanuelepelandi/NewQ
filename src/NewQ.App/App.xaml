<Application x:Class="NewQ.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:c="clr-namespace:NewQ.App.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Soft blue accent instead of the Windows accent (selection, checkboxes, progress). -->
                <ui:ThemeResources RequestedTheme="Dark" AccentColor="#5B8DD6" />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============ Palette (soft, low-saturation) ============ -->
            <Color x:Key="WindowColor">#131418</Color>
            <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
            <SolidColorBrush x:Key="HeaderBrush" Color="#181A1F" />
            <SolidColorBrush x:Key="PanelBrush" Color="#1C1E23" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#2A2D34" />
            <SolidColorBrush x:Key="SubtleFillBrush" Color="#23262C" />

            <SolidColorBrush x:Key="GoBrush" Color="#3F9A6B" />
            <SolidColorBrush x:Key="StopBrush" Color="#B9615F" />
            <SolidColorBrush x:Key="PanicBrush" Color="#C48A52" />
            <SolidColorBrush x:Key="PausedBrush" Color="#5B83C2" />

            <SolidColorBrush x:Key="RunningBrush" Color="#7CC79C" />
            <SolidColorBrush x:Key="RunningRowBrush" Color="#163F9A6B" />
            <SolidColorBrush x:Key="PreWaitBrush" Color="#D9B867" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#E08A86" />
            <SolidColorBrush x:Key="PlayheadBrush" Color="#E9C46A" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#8C919B" />
            <SolidColorBrush x:Key="SoftTextBrush" Color="#C9CCD2" />
            <SolidColorBrush x:Key="InactiveBrush" Color="#E3AE5B" />
            <SolidColorBrush x:Key="ClipBrush" Color="#E0504B" />
            <SolidColorBrush x:Key="InactiveTintBrush" Color="#33E3AE5B" />

            <c:CueTypeBrushConverter x:Key="TypeForeground" />
            <c:CueTypeBrushConverter x:Key="TypeBackground" Alpha="40" />

            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

            <!-- ============ Shared styles ============ -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="Margin" Value="0,16,0,6" />
            </Style>

            <!-- Rounded "card" containers. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <!-- Flat coloured button with rounded corners; hover/press lighten/darken softly. -->
            <Style x:Key="SoftButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                        CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=8, TargetNullValue=8}" />
                                <Border x:Name="Overlay" Background="White" Opacity="0"
                                        CornerRadius="{Binding CornerRadius, ElementName=Bg}" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Overlay" Property="Opacity" Value="0.08" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Overlay" Property="Background" Value="Black" />
                                    <Setter TargetName="Overlay" Property="Opacity" Value="0.15" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
