<Application x:Class="NewQ.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:c="clr-namespace:NewQ.App.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ModernWpfUI is the foundation; the accent matches the NewQ accent token. -->
                <ui:ThemeResources RequestedTheme="Dark" AccentColor="#5B8DD6" />
                <ui:XamlControlsResources />
                <!-- NewQ design system: tokens first, then the styles built on them. -->
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <c:CueTypeBrushConverter x:Key="TypeForeground" />
            <c:CueTypeBrushConverter x:Key="TypeBackground" Alpha="40" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
