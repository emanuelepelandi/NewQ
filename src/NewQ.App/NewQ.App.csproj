<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Windows.Forms.Screen (monitor enumeration). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>NewQ.App</RootNamespace>
    <AssemblyName>NewQ</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icon of NewQ.exe (Explorer, shortcuts); the windows use the same file as a resource. -->
    <ApplicationIcon>Assets\NewQ.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WinForms analyzer: DPI awareness for a WPF app is correctly declared in app.manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- libVLC: only the 64-bit native libraries, without VLC's GUI/script/visualisation plugins. -->
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsX64ExcludeFiles>plugins\gui\%2A;plugins\lua\%2A;plugins\visualization\%2A;lua\%2A;plugins\control\%2A;plugins\services_discovery\%2A</VlcWindowsX64ExcludeFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="LibVLCSharp" Version="3.8.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="Vortice.Direct3D11" Version="2.4.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\NewQ.ico" />
  </ItemGroup>

  <!-- libVLC's DirectShow input (Live cues), missing from the NuGet package: see ThirdParty/libvlc/README.md. -->
  <ItemGroup>
    <None Include="ThirdParty\libvlc\win-x64\plugins\access\libdshow_plugin.dll"
          Link="libvlc\win-x64\plugins\access\libdshow_plugin.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdParty\libvlc\COPYING-VLC.txt" Link="libvlc\COPYING-VLC.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewQ.Core\NewQ.Core.csproj" />
  </ItemGroup>

</Project>
